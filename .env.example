# ── Server ──
NODE_ENV=development
PORT=5000

# ── Database ──
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/autotask?retryWrites=true&w=majority
# AZURE_COSMOS=false
#
# For Azure Cosmos DB (MongoDB API):
# MONGO_URI=mongodb://<account-name>:<primary-key>@<account-name>.mongo.cosmos.azure.com:10255/autotask?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@<account-name>@
# AZURE_COSMOS=true
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/autotask?retryWrites=true&w=majority
AZURE_COSMOS=false

# ── Auth ──
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── AI (NVIDIA) ──
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Client ──
# In production, set to your domain (e.g. https://autotask.yourdomain.com)
CLIENT_URL=http://localhost:5173
